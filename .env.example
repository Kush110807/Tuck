# Public Expo client configuration. These values are safe to embed in the client;
# authorization MUST come from Supabase Auth + RLS/RPC checks, not key secrecy.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR_PUBLIC_ANON_OR_PUBLISHABLE_KEY

